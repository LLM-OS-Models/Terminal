MODEL_PATH=LiquidAI/LFM2.5-8B-A1B
SFT_ADAPTER_PATH=/home/work/.data/liquid_cli_sft/models/LFM2.5-8B-A1B__harness1_lora_sft_r32_h200_8gpu_reloadable_3epoch/final_lora

# Paper-aligned RL domain. Harness-1 RL trains on SEC, not BrowseComp+.
# These HF datasets and the sec_1_4 Chroma collection are not public-ready in the
# cloned Harness-1 release, so this config intentionally fails fast until access
# or a materialized SEC candidate JSONL is provided.
DATASET_KIND=harness_hf
HF_DATASET=kellyhongg/1_18_sec_train
HF_SPLIT=train
SPLIT_IDS_PATH=harness-1/datagen/splits/sec_splits.json
SPLIT_ID_KEY=rl_query_ids
ALLOW_GOLD_ONLY_CANDIDATES=0

DATASET_PATH=/home/work/.data/liquid_cli_sft/datasets/lfm25_harness1_retrieval_rlvr_sec_v1
OUTPUT_DIR=/home/work/.data/liquid_cli_sft/models/LFM2.5-8B-A1B__harness1_retrieval_rlvr_grpo_r32_sec_v1

MAX_DOC_CHARS=900
MAX_GOLD_DOCS=24
MAX_EVIDENCE_DOCS=0
MAX_NEGATIVE_DOCS=0

MAX_SEQ_LENGTH=16384
MAX_PROMPT_LENGTH=8192
MAX_COMPLETION_LENGTH=512
PER_DEVICE_TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=1
NUM_GENERATIONS=8
MAX_STEPS=300
LEARNING_RATE=2e-6
WARMUP_RATIO=0.05
SAVE_STEPS=25
LOGGING_STEPS=1
BETA=0.02
TEMPERATURE=0.8
TOP_P=0.95
MIN_P=0.05

LORA_RANK=32
LORA_ALPHA=64
LORA_DROPOUT=0.0
TARGET_MODULES=q_proj,k_proj,v_proj,out_proj,in_proj,w1,w2,w3,gate

NPROC_PER_NODE=8
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
DATALOADER_NUM_WORKERS=0
USE_VLLM=0
PUSH_TO_HUB=0
HUB_MODEL_ID=LLM-OS-Models/LFM2.5-8B-A1B-Harness1-SEC-RLVR-GRPO-LoRA
RUN_NAME=rlvr_h200_8gpu_lfm25_8b_a1b_harness1_sec_grpo_r32
EVAL_AFTER_TRAIN=1
EVAL_CUDA_VISIBLE_DEVICES=0
EVAL_SPLIT_LIMIT=0
