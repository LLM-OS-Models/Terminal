MAX_SEQ_LENGTH=32768
PER_DEVICE_TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=16
LEARNING_RATE=5e-6
NUM_TRAIN_EPOCHS=3
SAVE_STRATEGY=steps
SAVE_STEPS=50
LOGGING_STEPS=1
WARMUP_RATIO=0.03
DATASET_NUM_PROC=16

LORA_RANK=32
LORA_ALPHA=64
LORA_DROPOUT=0.0
TARGET_MODULES=all-linear

PUSH_TO_HUB=0
