HARNESS_DATASETS=browsecompplus,sec,patents,web
HARNESS_NUM_QUERIES=50
HARNESS_WORKERS=8
HARNESS_SPLIT=sft
HARNESS_MIN_FINAL_RECALL=0.10
HARNESS_RECENT_TURNS=5
HARNESS_MAX_OBSERVATION_CHARS=12000
HARNESS_MAX_OLDER_SUMMARY_CHARS=2000
HARNESS_MAX_TURNS=40
GENERATE_TRAJECTORIES=0
BUILD_DATASET=1

# LFM conversation dataset emitted by build_lfm_harness1_dataset.py.
DATASET_NAME=
DATASET_SPLIT=train
DATASET_PATH=/home/work/.data/liquid_cli_sft/datasets/lfm25_8b_a1b_harness1_sft_turn_context_v1
